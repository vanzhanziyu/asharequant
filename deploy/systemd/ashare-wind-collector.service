[Unit]
Description=A-share Wind Micro-cap Collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=admin
WorkingDirectory=/opt/ashare-market-monitor/backend
ExecStart=/opt/ashare-market-monitor/backend/.venv/bin/python -u wind_collector.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
