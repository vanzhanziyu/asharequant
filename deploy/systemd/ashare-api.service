[Unit]
Description=A-share Market Monitor API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=admin
WorkingDirectory=/opt/ashare-market-monitor/backend
EnvironmentFile=-/opt/ashare-market-monitor/backend/.env
ExecStart=/opt/ashare-market-monitor/backend/.venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
